---
/**
 * QA parity page — mirrors `scaffold-design/index.html` (the labs baseline) so
 * reviewers can eyeball the Astro wrapper against the vanilla player.
 *
 * Two players, differing accent/position/language, exactly like the oracle.
 * Run with: `pnpm --filter vidix-player-astro-e2e run preview`.
 */

import { VidixPlayer } from "@mekbrut-com/vidix-player-astro";

const thumbnail = "https://files.vidstack.io/sprite-fight/poster.webp";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>vidix-player | test page (Astro)</title>
    <style>
      body {
        margin: 0;
        min-block-size: 100vh;
        padding: 1rem;
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          Oxygen,
          Ubuntu,
          Cantarell,
          "Open Sans",
          "Helvetica Neue",
          sans-serif;
      }
      main {
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }
      .qa-note {
        font-size: 0.875rem;
        line-height: 1.5;
        color: #555;
        background: #f4f4f8;
        border: 1px solid #e0e0ea;
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
      }
      .qa-note code {
        font-size: 0.8em;
      }
    </style>
  </head>
  <body>
    <main>
      <section class="qa-note">
        <strong>QA page — Astro vs vanilla parity.</strong>
        Two players with different accent/position/language (same as
        <code>scaffold-design/index.html</code>): green/red at the bottom
        (<code>lang="id"</code>) and yellow/blue at the top (<code>lang="es"</code>).
        The 16:9 skeleton + critical CSS are server-rendered before JavaScript runs
        (Declarative Shadow DOM), so there is no layout shift.
      </section>

      <VidixPlayer
        playbackId="vod-1_parameter_server"
        lang="id"
        accentColor="green"
        layout={{ controlPosition: "bottom", controlAccent: "red" }}
        metadata={{
          videoTitle: "Test VOD",
          thumbnailUrl: thumbnail,
          serverTitle: true,
        }}
        control={{ share: true, serverCount: 3, download: true }}
        loading="eager"
        consoleLog={true}
        role="region"
        ariaLabel="Video player"
      />

      <VidixPlayer
        playbackId="vod-1_thumbnail"
        lang="es"
        accentColor="yellow"
        layout={{ controlPosition: "top", controlAccent: "blue" }}
        metadata={{
          videoTitle: "Test VOD",
          thumbnailUrl: thumbnail,
          serverTitle: true,
        }}
        control={{ share: true, serverCount: 3, download: true }}
        loading="eager"
        consoleLog={false}
        role="region"
        ariaLabel="Video player"
      />
    </main>
  </body>
</html>
